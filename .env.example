# =============================================================================
# Qii HRMS secrets (single company, fixed DB connection per service) — copy to `.env`:
#   cp .env.example .env
#
# Docker Compose loads `.env` automatically.
# Frontend BFF: run  node scripts/sync-frontend-env.mjs  (or up-local.sh does it)
# Java services auto-load this file for local IDE runs via DotEnvEnvironmentPostProcessor.
# OS env still wins; set PLATFORM_DOTENV_DISABLED=true to turn off. NEVER commit `.env`.
# In production inject these from a secrets manager — never from a file baked into an image.
# =============================================================================

# --- Shared platform keys -----------------------------------------------------
JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long
PLATFORM_SERVICE_KEY=change-me-platform-service-key
PLATFORM_INTERNAL_KEY=change-me-platform-internal-key
PLATFORM_ADMIN_KEY=change-me-platform-admin-key
# Prometheus / metrics scrape credential (guide §9). /actuator/health stays open; every other actuator
# endpoint requires 'Authorization: Bearer <key>' or 'X-Metrics-Key'. Empty = loopback callers only.
PLATFORM_METRICS_KEY=change-me-platform-metrics-key
# Session lifetime of gateway-issued tokens (seconds).
TOKEN_TTL_SECONDS=604800

# Account-picker / demo login (BFF → gateway POST /api/auth/token). Distinct from PLATFORM_SERVICE_KEY.
# Must stay false — production login is Google OIDC (SEC-02).
DEMO_AUTH_ENABLED=false
DEMO_AUTH_KEY=change-me-demo-auth-key

# Google OIDC (Authorization Code + PKCE). BFF holds client secret; browser never sees it.
OIDC_ENABLED=true
GOOGLE_CLIENT_ID=change-me-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me-google-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_BFF_KEY=change-me-oidc-bff-key-at-least-32-chars
# Production: qiicreative.com.au. Local test may add ,gmail.com
OIDC_ALLOWED_EMAIL_DOMAINS=qiicreative.com.au
# Optional Google hosted-domain hint. Empty allows consumer Gmail for local testing.
GOOGLE_HD=

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- PostgreSQL ---------------------------------------------------------------
# Superuser of each local Postgres container (bootstrap / migration scripts only — never used by services).
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser

# One fixed database per service (guide §1/§5). Two roles per database:
#   <SVC>_DB_USER / _PASSWORD                   runtime role (<svc>_app, DML only)
#   <SVC>_DB_MIGRATION_USER / _MIGRATION_PASSWORD schema owner (<svc>_migrator, Liquibase only)
# URLs/users default to the local Compose layout; override per environment.
# PEOPLE_DB_URL=jdbc:postgresql://127.0.0.1:5433/people_db
PEOPLE_DB_PASSWORD=change-me-people-app
PEOPLE_DB_MIGRATION_PASSWORD=change-me-people-migrator
# LEAVE_DB_URL=jdbc:postgresql://127.0.0.1:5433/leave_db
LEAVE_DB_PASSWORD=change-me-leave-app
LEAVE_DB_MIGRATION_PASSWORD=change-me-leave-migrator
# TIMEWORK_DB_URL=jdbc:postgresql://127.0.0.1:5433/timework_db
TIMEWORK_DB_PASSWORD=change-me-timework-app
TIMEWORK_DB_MIGRATION_PASSWORD=change-me-timework-migrator
# PAYROLL_DB_URL=jdbc:postgresql://127.0.0.1:5434/payroll_db
PAYROLL_DB_PASSWORD=change-me-payroll-app
PAYROLL_DB_MIGRATION_PASSWORD=change-me-payroll-migrator
# FILES_DB_URL=jdbc:postgresql://127.0.0.1:5436/files_db
FILES_DB_PASSWORD=change-me-files-app
FILES_DB_MIGRATION_PASSWORD=change-me-files-migrator
# NOTIFICATION_DB_URL=jdbc:postgresql://127.0.0.1:5436/notification_db
NOTIFICATION_DB_PASSWORD=change-me-notification-app
NOTIFICATION_DB_MIGRATION_PASSWORD=change-me-notification-migrator
# REPORT_DB_URL=jdbc:postgresql://127.0.0.1:5436/reports_db
REPORT_DB_PASSWORD=change-me-report-app
REPORT_DB_MIGRATION_PASSWORD=change-me-report-migrator

# --- MinIO (private object storage for company documents) --------------------
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password
MINIO_ENDPOINT=http://127.0.0.1:9000
FILE_STORAGE_BUCKET=qii-hrms-documents
# MinIO server image (optional override). Default: maintained Chainguard build pinned by digest — the
# upstream minio/minio Docker Hub image was removed when MinIO archived its community edition.
# MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:...

# --- Redis AUTH (gateway session revocation) ----------------------------------
REDIS_PASSWORD=change-me-redis-password

PLATFORM_MESSAGING_ENABLED=true

# --- File download tokens (guide §8; defaults to JWT_SECRET) -------------------
# FILE_DOWNLOAD_SIGNING_KEY=
FILE_DOWNLOAD_TTL_SECONDS=120
FILE_RETENTION_REJECTED_DAYS=30

# --- Traffic protection & runtime budgets (optional; defaults shown) -----------
# Edge rate limit per signed-in employee (Redis token bucket) — exceeding it returns 429.
# GATEWAY_RATE_LIMIT_PER_SECOND=20
# GATEWAY_RATE_LIMIT_BURST=60
# Gateway → service deadlines and connection budget.
# GATEWAY_CONNECT_TIMEOUT_MS=3000
# GATEWAY_RESPONSE_TIMEOUT=30s
# GATEWAY_POOL_MAX_CONNECTIONS=1000
# Service → service HTTP deadlines.
# PLATFORM_HTTP_CONNECT_TIMEOUT_MS=3000
# PLATFORM_HTTP_READ_TIMEOUT_MS=10000
# Per-connection PostgreSQL safety nets (runtime role only; migrations unaffected).
# DB_STATEMENT_TIMEOUT=60s
# DB_LOCK_TIMEOUT=15s
# DB_IDLE_TX_TIMEOUT=120s
# Pool size per service instance: keep (pool × replicas) of all services on one Postgres below max_connections.
# PEOPLE_DB_POOL_SIZE=10
# LEAVE_DB_POOL_SIZE=15
# TIMEWORK_DB_POOL_SIZE=15
# Tomcat worker budget per service.
# SERVER_MAX_THREADS=200
# SERVER_ACCEPT_COUNT=100
