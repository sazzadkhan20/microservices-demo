# =============================================================================
# HRMS platform secrets — copy to `.env` then edit:
#   cp .env.example .env
#
# Docker Compose loads `.env` automatically.
# Frontend BFF: run  node scripts/sync-frontend-env.mjs  (or up-local.sh does it)
# Java services auto-load this file via DotEnvEnvironmentPostProcessor (walks up
# from the module working directory). OS env still wins; set
# PLATFORM_DOTENV_DISABLED=true to turn off. NEVER commit `.env`.
# =============================================================================

# --- Shared platform keys (must match across gateway + all services) ----------
JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long
PLATFORM_SERVICE_KEY=change-me-platform-service-key
PLATFORM_INTERNAL_KEY=change-me-platform-internal-key
PLATFORM_ADMIN_KEY=change-me-platform-admin-key

# Account-picker / demo login (BFF → gateway). Distinct from PLATFORM_SERVICE_KEY.
# Local demo only — must stay false under prod profile (SEC-02).
DEMO_AUTH_ENABLED=false
DEMO_AUTH_KEY=change-me-demo-auth-key

# --- RabbitMQ -----------------------------------------------------------------
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=change-me-rabbitmq-password

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_SUPERUSER_PASSWORD=change-me-postgres-superuser
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=change-me-platform-db-password

REGISTRY_DB_URL=jdbc:postgresql://127.0.0.1:5435/registry_db
REGISTRY_DB_USER=platform
REGISTRY_DB_PASSWORD=change-me-platform-db-password

HRMS_PG_USER=platform
HRMS_PG_PASSWORD=change-me-platform-db-password
PAYROLL_PG_USER=platform
PAYROLL_PG_PASSWORD=change-me-platform-db-password
FILES_PG_USER=platform
FILES_PG_PASSWORD=change-me-platform-db-password
NOTIF_PG_USER=platform
NOTIF_PG_PASSWORD=change-me-platform-db-password
REPORT_PG_USER=platform
REPORT_PG_PASSWORD=change-me-platform-db-password
PEOPLE_PG_USER=platform
PEOPLE_PG_PASSWORD=change-me-platform-db-password
LEAVE_PG_USER=platform
LEAVE_PG_PASSWORD=change-me-platform-db-password
TIMEWORK_PG_USER=platform
TIMEWORK_PG_PASSWORD=change-me-platform-db-password

# --- MinIO (object storage for file-service; always started with compose infra) -
# ACCESS_KEY/SECRET_KEY must match ROOT_USER/ROOT_PASSWORD (apps authenticate as root).
# Password min length 8. Changing credentials requires recreating volume minio_data.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password
MINIO_ENDPOINT=http://127.0.0.1:9000

# --- Redis AUTH (SEC-05) ------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password

PLATFORM_MESSAGING_ENABLED=true

# --- File download tokens (guide §8; defaults to JWT_SECRET) -------------------
# FILE_DOWNLOAD_SIGNING_KEY=
FILE_DOWNLOAD_TTL_SECONDS=120
FILE_RETENTION_REJECTED_DAYS=30
