{
  "info": {
    "name": "Qii Creative HRMS",
    "description": "Account-picker JWT flow + HRMS / payroll / notifications / files / reports via Gateway :8090",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "gateway", "value": "http://127.0.0.1:8090" },
    { "key": "tenantId", "value": "qii_creative" },
    { "key": "token", "value": "" },
    { "key": "employeeId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Provision",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"businessPack\": \"qii_creative\"\n}"
        },
        "url": "{{gateway}}/api/registry/provision"
      }
    },
    {
      "name": "1. List accounts",
      "request": {
        "method": "GET",
        "url": "{{gateway}}/hrms/api/auth/accounts?tenantId={{tenantId}}"
      }
    },
    {
      "name": "2. Issue token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('token', j.token || j.accessToken);",
              "if (j.employeeId) pm.collectionVariables.set('employeeId', String(j.employeeId));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenantId\": \"{{tenantId}}\",\n  \"employeeId\": {{employeeId}}\n}"
        },
        "url": "{{gateway}}/api/registry/token"
      }
    },
    {
      "name": "3. Me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/hrms/api/me"
      }
    },
    {
      "name": "4. Attendance today",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/hrms/api/attendance/today"
      }
    },
    {
      "name": "5. Check-in",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/hrms/api/attendance/check-in"
      }
    },
    {
      "name": "6. My leave",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/hrms/api/leave/my"
      }
    },
    {
      "name": "7. Employees",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/hrms/api/employees"
      }
    },
    {
      "name": "8. Notifications",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{gateway}}/notifications/api/notifications"
      }
    },
    {
      "name": "9. Attendance monthly CSV",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"year\": 2026,\n  \"month\": 10\n}"
        },
        "url": "{{gateway}}/reports/api/reports/attendance/monthly"
      }
    }
  ]
}
