TENANT_ID=qii_creative
GATEWAY_URL=http://127.0.0.1:8090
COOKIE_NAME=qii_session
# COOKIE_SECURE=true in production HTTPS
GATEWAY_TIMEOUT_MS=30000

# Account-picker shared secret (server-side only; sent to the gateway as X-Demo-Auth-Key).
# Must equal the gateway DEMO_AUTH_KEY. Distinct from PLATFORM_SERVICE_KEY.
DEMO_AUTH_KEY=local-demo-auth-key-change-me
