GATEWAY_URL=http://127.0.0.1:8090
COOKIE_NAME=qii_session
# COOKIE_SECURE=true in production HTTPS
GATEWAY_TIMEOUT_MS=30000

# Prefer: node ../../scripts/sync-frontend-env.mjs  (copies from root .env)
DEMO_AUTH_ENABLED=false
DEMO_AUTH_KEY=

# Google OIDC (server-side only — never NEXT_PUBLIC_*)
OIDC_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_BFF_KEY=
GOOGLE_HD=
