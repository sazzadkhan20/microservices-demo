{
  "id": "impit_limited",
  "displayName": "Impit Limited",
  "settings": {
    "businessPack": "impit_limited",
    "employeeCodePattern": "^\\d{4}$",
    "employeeCodePrefix": "",
    "employeeCodeDigits": 4,
    "employeeCodeMode": "AUTO",
    "defaultCreateRoleCodes": ["EMPLOYEE"],
    "defaultTimeZone": "Asia/Dhaka",
    "approvalAuthority": {
      "overrideRoleCodes": ["SUPERADMIN", "ADMIN"],
      "overridePermissions": [],
      "roleDefaults": {
        "MANAGER": { "resolver": "REPORTING_MANAGER", "allowOverride": true },
        "STORE_MANAGER": { "resolver": "REPORTING_MANAGER_AND_DESIGNATION", "allowOverride": true },
        "HR": { "resolver": "DESIGNATION_OR_RBAC", "roleCodes": ["HR"], "allowOverride": false },
        "ADMIN": { "resolver": "RBAC_ROLE", "roleCodes": ["ADMIN", "SUPERADMIN"], "allowOverride": true },
        "SUPER_ADMIN": { "resolver": "RBAC_ROLE", "roleCodes": ["SUPERADMIN"], "allowOverride": true },
        "*": { "resolver": "DESIGNATION_OR_RBAC", "allowOverride": false }
      }
    },
    "employeeRules": {
      "requiredForActive": ["fullName", "email", "departmentId", "locationId", "startDate", "managerId"],
      "requireManagerOnCreate": true
    },
    "reportingLine": {
      "requireEffectiveDate": true,
      "allowPastEffectiveDate": false,
      "allowFutureEffectiveDate": true,
      "maxPastDays": 0,
      "maxFutureDays": 3650
    },
    "scheduleRules": {
      "modes": ["FIXED", "HOURLY"],
      "scopes": ["LOCATION", "TEAM", "EMPLOYEE"],
      "resolveOrder": ["EMPLOYEE", "TEAM", "LOCATION"],
      "defaultGraceMinutes": 10,
      "defaultHalfDayHours": 4,
      "defaultCheckoutCutoff": "23:59",
      "requireUniqueScope": true,
      "patternTemplates": {
        "DAYS_5": {
          "mode": "FIXED",
          "workingDays": ["MON", "TUE", "WED", "THU", "FRI"],
          "inheritLocationHours": true
        },
        "DAYS_6": {
          "mode": "FIXED",
          "workingDays": ["MON", "TUE", "WED", "THU", "FRI", "SAT"],
          "inheritLocationHours": true
        },
        "HOURLY": {
          "mode": "HOURLY",
          "weeklyHours": 40
        }
      }
    }
  },
  "leavePolicy": {
    "annualDays": 0,
    "workWeekDays": 5,
    "workingDays": ["MON", "TUE", "WED", "THU", "FRI"],
    "unionNoticeDays": 0,
    "nonUnionNoticeDays": 0,
    "requireCoverageCheck": true,
    "approvalChain": [
      { "step": 1, "role": "MANAGER", "resolver": "REPORTING_MANAGER", "allowOverride": true },
      { "step": 2, "role": "HR", "resolver": "DESIGNATION_OR_RBAC", "allowOverride": false }
    ],
    "noticeMode": "NONE",
    "defaultNoticeDays": 0,
    "coverageMode": "LOCATION",
    "locationField": "office_id",
    "shiftField": "shift_pattern",
    "requireReliefOnCoverageFail": false,
    "defaultLeaveTypeCode": "CASUAL"
  },
  "fieldDefinitions": []
}
